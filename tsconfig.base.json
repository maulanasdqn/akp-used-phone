{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "esnext",
      "dom"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/shared/trpc/*": [
        "shared/trpc/src/*"
      ]
    },
    "types": [
      "bun-types"
    ]
  }
}
