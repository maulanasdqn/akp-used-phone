{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "./",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/shared/api/app": ["shared/api/app/src/index.ts"],
      "@/shared/api/database": ["shared/api/database/src/index.ts"],
      "@/shared/api/trpc": ["shared/api/trpc/src/index.ts"],
      "@/shared/web/components/*": ["shared/web/components/src/*"],
      "@/shared/web/utils": ["shared/web/utils/src/index.ts"],
      "@/shared/api/utils": ["shared/api/utils/src/index.ts"]
    },
    "types": ["bun-types"]
  }
}
