{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/store/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "../../dist/apps/store"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/api/src/main.ts"
    },
    {
      "src": "/v1/trpc/(.*)",
      "dest": "/apps/api/src/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/store/$1"
    }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install"
}
