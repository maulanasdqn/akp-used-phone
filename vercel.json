{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/api/src/main.ts"
    },
    {
      "src": "/v1/trpc/(.*)",
      "dest": "/apps/api/src/main.ts"
    },
    {
      "src": "/backoffice/(.*)",
      "dest": "/apps/backoffice/$1"
    },
    {
      "src": "/backoffice",
      "dest": "/apps/backoffice/index.html"
    },
    {
      "src": "/store/(.*)",
      "dest": "/apps/store/$1"
    },
    {
      "src": "/store",
      "dest": "/apps/store/index.html"
    }
  ],
  "buildCommand": "nx build api && nx build store && nx build backoffice",
  "installCommand": "npm install"
}
