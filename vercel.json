{
  "version": 2,
  "builds": [
    {
      "src": "dist/apps/api/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/apps/api/main.js"
    },
    {
      "src": "/v1/trpc/(.*)",
      "dest": "/dist/apps/api/main.js"
    },
    {
      "src": "/backoffice/(.+\\.(?:js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map))$",
      "dest": "/dist/apps/backoffice/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/backoffice/(.*)",
      "dest": "/dist/apps/backoffice/index.html"
    },
    {
      "src": "/store/(.+\\.(?:js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map))$",
      "dest": "/dist/apps/store/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/store/(.*)",
      "dest": "/dist/apps/store/index.html"
    }
  ],
  "buildCommand": "nx build api && nx build store && nx build backoffice",
  "installCommand": "npm install"
}
