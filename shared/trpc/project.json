{
  "name": "global-trpc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/trpc/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/shared/trpc"],
      "options": {
        "command": "tsc -p shared/trpc/tsconfig.lib.json",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["shared/trpc/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
