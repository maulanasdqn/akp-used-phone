generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id        String   @id @default(dbgenerated("ulid_generate()")) @db.Uuid
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AppProduct {
  id                    String   @id @default(dbgenerated("ulid_generate()")) @db.Uuid
  sku                   String   @unique
  slug                  String   @unique
  name                  String
  description           String
  price                 Decimal  @db.Decimal
  imageUrl              String?
  stockQuantity         Int
  minimumOrderQuantity  Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}