{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "tsc -p apps/api/tsconfig.app.json",
        "cwd": "."
      },
      "dependsOn": ["^build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run --watch apps/api/src/main.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/api/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "build:workers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc src/main-workers.ts --outDir ../../dist/apps/api --module es2022 --target es2022 --moduleResolution node --skipLibCheck",
        "cwd": "apps/api"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy",
        "cwd": "apps/api"
      },
      "dependsOn": ["build", "build:workers"]
    },
    "deploy:staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env staging",
        "cwd": "apps/api"
      },
      "dependsOn": ["build"]
    }
  }
}
